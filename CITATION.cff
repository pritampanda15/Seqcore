type: software
title: "Seqcore: A High-Performance Biological Sequence Analysis Library"
version: 0.4.0
date-released: 2026-08-26
url: "https://github.com/pritampanda15/seqcore"
repository-code: "https://github.com/pritampanda15/seqcore"
license: MIT
authors:
  - family-names: "Panda"
    given-names: "Pritam Kumar"
    email: "pritam@stanford.edu"
